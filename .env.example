# Dedicated application database schema; do not point migrations at HOSxP.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/orreg_aranhos"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:50004"

# HOSxP must use a separate MySQL account granted SELECT only.
HOSXP_HOST=""
HOSXP_PORT=""
HOSXP_DATABASE=""
HOSXP_USER=""
HOSXP_PASSWORD=""

MOPH_HEALTH_ID_BASE_URL=
MOPH_HEALTH_ID_CLIENT_ID=
MOPH_HEALTH_ID_CLIENT_SECRET=
MOPH_PROVIDER_ID_BASE_URL=
MOPH_PROVIDER_ID_CLIENT_ID=
MOPH_PROVIDER_ID_CLIENT_SECRET=

# Optional: send new HOSxP surgery requests to the configured Mor Prom group.
# The scheduler starts only when both group credentials are configured.
MOPH_NOTIFY_API_URL="https://morpromt2f.moph.go.th/api/notify/send"
MOPH_NOTIFY_GROUP_CLIENT_KEY=
MOPH_NOTIFY_GROUP_SECRET_KEY=
# Optional public HTTPS URL for the OR-Reg logo used in MOPH Flex cards.
MOPH_NOTIFY_ORREG_LOGO_URL=

# Required to deliver password-reset emails. Keep these values in the server environment only.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Keep these modules disabled in the first production rollout; enable only after separate review.
ORREG_POSTOP_ENABLED=false
ORREG_EQUIPMENT_ENABLED=false

# Server-to-server reports only. Unset disables /api/external/reports.
# Use a unique random secret of at least 32 characters; never NEXT_PUBLIC_.
EXTERNAL_REPORTS_API_KEY=
